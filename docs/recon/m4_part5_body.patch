 		return nullptr;
 	}
 	Effectors.Add(Effector);
+	// The player's own hands and feet do not meet the player's body. (Bodies whose filter masks share a bit ignore each other;
+	// a rig without a body has no masks, and its hands meet each other as they always did.)
+	const auto SetMask = [](USandboxEffectorComponent* Each, uint8 Mask) { Each->SetMaskFilterOnBodyInstance(FMaskFilter(Mask)); };
+	USandboxEffectorComponent* Body = FindEffector(SandboxEffectors::Body);
+	if (Body)
+	{
+		uint8 Bit = 1;
+		uint8 Others = 0;
+		for (USandboxEffectorComponent* Each : Effectors)
+		{
+			if (Each != Body)
+			{
+				SetMask(Each, Bit);
+				Others |= Bit;
+				Bit <<= 1;
+			}
+		}
+		SetMask(Body, Others);
+	}
 	return Effector;
 }
 
