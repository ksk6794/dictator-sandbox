+void USandboxBodyController::ReleaseHeldFoot(int32 Side)
+{
+	if (!GetUpRun.Step[Side].bLifting)
+	{
+		return;
+	}
+	GetUpRun.Step[Side].bLifting = false;
+	if (USandboxAnimInstance* Animation = Cast<USandboxAnimInstance>(Mesh->GetAnimInstance()))
+	{
+		if (const FVector* Placed = PlacedFeet.Find(FootBoneIndex[Side]))
+		{
+			Animation->SetLimbTarget(FootBoneIndex[Side], *Placed, 0.0, Tuning.Balance.StepEaseS);
+		}
+	}
+	PlacedFeet.Remove(FootBoneIndex[Side]);
+}
+
+bool USandboxBodyController::UpdateStepHold(const FSandboxClipPose& Clip, double DeltaTime)
+{
+	const FSandboxGetUpTuning& Limits = Tuning.GetUp;
+	USandboxAnimInstance* Animation = Cast<USandboxAnimInstance>(Mesh->GetAnimInstance());
+	if (!Animation || !Balance.bValid || Limits.StepLookS <= 0.0)
+	{
+		return false;
+	}
+	bool bHeld = false;
+	int32 HeldSide = INDEX_NONE;
+	for (int32 Side = 0; Side < 2; ++Side)
+	{
+		FGetUpRun::FStepHold& Hold = GetUpRun.Step[Side];
+		FTransform FootNow, FootAhead;
+		const bool bKnown = Clip.BodyAt(FootBoneName[Side], ClipHold.TimeS, FootNow) &&
+			Clip.BodyAt(FootBoneName[Side], FMath::Min(ClipHold.TimeS + Limits.StepLookS, Clip.GetLengthS()), FootAhead);
+		const FVector Way = bKnown ? FootAhead.GetLocation() - FootNow.GetLocation() : FVector::ZeroVector;
+		const bool bMoves = bKnown && Way.Size2D() > Limits.StepSpeedCmS * Limits.StepLookS;
+		if (!bMoves)
+		{
+			Hold.QuietS += DeltaTime;
+			if (Hold.QuietS > 0.1)
+			{
+				ReleaseHeldFoot(Side);
+				Hold = FGetUpRun::FStepHold();
+			}
+			continue;
+		}
+		Hold.QuietS = 0.0;
+		if (Hold.bGoing)
+		{
+			// With the clip's foot, in the world, held clear of the floor by the leg's own placement.
+			const FTransform World = FootNow * GetUpRun.Frame;
+			Hold.Point += (World.GetLocation() + FVector(0.0, 0.0, 3.0) - Hold.Point) * FMath::Min(DeltaTime / 0.1, 1.0);
+			Animation->MoveLimbTarget(FootBoneIndex[Side], Hold.Point, nullptr);
+			PlacedFeet.Add(FootBoneIndex[Side], Hold.Point);
+			continue;
+		}
+		if (Hold.bDone)
+		{
+			continue;
+		}
+		const bool bOtherUp = GetUpRun.Step[1 - Side].bLifting;
+		const bool bLoaded = Balance.FootForceN[Side] >= Limits.StepFreeN;
+		Hold.FreeS = bLoaded ? 0.0 : Hold.FreeS + DeltaTime;
+		if (Hold.HoldS >= Limits.StepWaitS)
+		{
+			// Waited for long enough: it goes as it is.
+			Hold.bDone = true;
+			ReleaseHeldFoot(Side);
+		}
+		else if (Hold.bLifting && Hold.FreeS >= 0.1)
+		{
+			Hold.bGoing = true;
+		}
+		else if (!bLoaded && !Hold.bLifting)
+		{
+			// Free from the start: the clip takes it.
+			Hold.bDone = true;
+		}
+		else if (Hold.bLifting || !bOtherUp)
+		{
+			Hold.HoldS += DeltaTime;
+			bHeld = true;
+			HeldSide = Side;
+			if (!Hold.bLifting)
+			{
+				Hold.bLifting = true;
+				Hold.Point = Mesh->GetBodyInstance(FootBoneName[Side])->GetUnrealWorldTransform().GetLocation() + FVector(0.0, 0.0, Limits.StepLiftCm);
+				Animation->SetLimbTarget(FootBoneIndex[Side], Hold.Point, 1.0, Tuning.Balance.StepEaseS);
+				PlacedFeet.Add(FootBoneIndex[Side], Hold.Point);
+			}
+		}
+	}
+
+	// While a foot is being lifted the pelvis is aimed at what carries the body: the other foot and the hands that
+	// are on the floor. Eased, as any goal.
+	FVector2D Wanted = FVector2D::ZeroVector;
+	if (bHeld && Limits.StepShiftCm > 0.0)
+	{
+		FVector2D Carry = FVector2D::ZeroVector;
+		double Number = 0.0;
+		const FBodyInstance* Other = Mesh->GetBodyInstance(FootBoneName[1 - HeldSide]);
+		if (Other && Balance.FootForceN[1 - HeldSide] > 0.0)
+		{
+			Carry += FVector2D(Other->GetUnrealWorldTransform().GetLocation());
+			Number += 1.0;
+		}
+		for (const FName Bone : { FName(TEXT("hand_l")), FName(TEXT("hand_r")) })
+		{
+			const FBodyInstance* Hand = Mesh->GetBodyInstance(Bone);
+			if (Hand && Hand->IsValidBodyInstance() && Hand->GetCOMPosition().Z - LastSupportHeightCm < 9.0)
+			{
+				Carry += FVector2D(Hand->GetUnrealWorldTransform().GetLocation());
+				Number += 1.0;
+			}
+		}
+		const FBodyInstance* Root = Mesh->GetBodyInstance(Tuning.Rig.Pelvis);
+		if (Number > 0.0 && Root)
+		{
+			Wanted = (Carry / Number - FVector2D(Root->GetUnrealWorldTransform().GetLocation())).GetSafeNormal() * Limits.StepShiftCm;
+		}
+	}
+	GetUpRun.StepShiftCm += (Wanted - GetUpRun.StepShiftCm) * FMath::Min(DeltaTime / 0.15, 1.0);
+	return bHeld;
+}
