+const TCHAR* USandboxBodyController::GetUpStageName(EGetUpStage Stage)
+{
+	static const TCHAR* const Names[] = { TEXT("clip"), TEXT("kneel"), TEXT("foot"), TEXT("rise") };
+	return Names[static_cast<int32>(Stage)];
+}
+
+void USandboxBodyController::EnterGetUpStage(EGetUpStage Stage)
+{
+	GetUpRun.Stage = Stage;
+	GetUpRun.StageS = 0.0;
+	ApplyPose();
+	UE_LOG(LogSandbox, Display, TEXT("Body controller: getting up, stage %s at %.3f s"), GetUpStageName(Stage), ElapsedS);
+}
+
+void USandboxBodyController::BeginRise(const FBodyInstance& PelvisBody)
+{
+	const FTransform Now = PelvisBody.GetUnrealWorldTransform();
+	const FAssist* Pelvis = Assists.FindByPredicate([](const FAssist& Assist) { return Assist.Slot == EAssistSlot::Pelvis; });
+	FQuat Tilt;
+	(Now.GetRotation() * Pelvis->SupportRotation.Inverse()).ToSwingTwist(FVector::UpVector, Tilt, GetUpRun.Heading);
+	GetUpRun.PelvisGoal = Now;
+	GetUpRun.PelvisGoal.SetScale3D(FVector::OneVector);
+	// The foot that is further forward already is the one to go on with.
+	const FVector Forward = GetUpRun.Heading.RotateVector(FVector(0.0, 1.0, 0.0));
+	double Ahead[2] = { 0.0, 0.0 };
+	for (int32 Side = 0; Side < 2; ++Side)
+	{
+		if (const FBodyInstance* Foot = Mesh->GetBodyInstance(FootBoneName[Side]))
+		{
+			Ahead[Side] = FVector::DotProduct(Foot->GetUnrealWorldTransform().GetLocation(), Forward);
+		}
+	}
+	GetUpRun.Front = Ahead[0] >= Ahead[1] ? 0 : 1;
+	GetUpRun.RiseShare = 0.0;
+	GetUpRun.bRearForward = false;
+	ReleaseClipPose();
+	EnterGetUpStage(EGetUpStage::Kneel);
+}
+
+void USandboxBodyController::SwingGetUpFoot(int32 Side, const FVector& Land, double DeltaTime, const FQuat& Level)
+{
+	USandboxAnimInstance* Animation = Cast<USandboxAnimInstance>(Mesh->GetAnimInstance());
+	const FBodyInstance* Body = Mesh->GetBodyInstance(FootBoneName[Side]);
+	FGetUpFoot& Foot = GetUpRun.Feet[Side];
+	if (!Animation || !Body)
+	{
+		return;
+	}
+	if (!Foot.bSwinging)
+	{
+		Foot.bSwinging = true;
+		Foot.ElapsedS = 0.0;
+		Foot.From = Body->GetUnrealWorldTransform().GetLocation();
+		if (!Foot.bPlanted)
+		{
+			Animation->SetLimbTarget(FootBoneIndex[Side], Foot.From, 1.0, 0.1);
+		}
+		Foot.bPlanted = false;
+	}
+	Foot.ElapsedS += DeltaTime;
+	const double Progress = FMath::Clamp(Foot.ElapsedS / FMath::Max(Tuning.GetUp.FootS, DeltaTime), 0.0, 1.0);
+	const double Across = FMath::SmoothStep(0.0, 1.0, Progress);
+	Foot.Point = FMath::Lerp(Foot.From, Land, Across) + FVector(0.0, 0.0, Tuning.GetUp.FootLiftCm * 4.0 * Across * (1.0 - Across));
+	Animation->MoveLimbTarget(FootBoneIndex[Side], Foot.Point, nullptr, &Level, 1.0, Tuning.Balance.LegExtensionMax);
+	const FVector Where = Body->GetUnrealWorldTransform().GetLocation();
+	// Down when it has come near where it is sent and touches the floor there, or when its time has run on to half as long again.
+	const bool bTouched = Progress >= 0.9 && FVector::Dist2D(Where, Land) <= 12.0 && Balance.bValid && Balance.FootForceN[Side] > 0.0;
+	if (bTouched || Foot.ElapsedS >= 1.5 * Tuning.GetUp.FootS)
+	{
+		const FVector At = Body->GetUnrealWorldTransform().GetLocation();
+		Foot.bSwinging = false;
+		Foot.bPlanted = true;
+		Foot.bFlat = true;
+		Foot.Point = FVector(At.X, At.Y, Land.Z);
+		UE_LOG(LogSandbox, Display, TEXT("Body controller: getting up, %s is set down at %.3f s, %.0f cm from where it was sent (%s)"), *FootBoneName[Side].ToString(), ElapsedS,
+			FVector::Dist2D(At, Land), bTouched ? TEXT("on the floor") : TEXT("in the air"));
+	}
+}
+
+void USandboxBodyController::ReleaseGetUpFeet(double BlendS)
+{
+	USandboxAnimInstance* Animation = Mesh ? Cast<USandboxAnimInstance>(Mesh->GetAnimInstance()) : nullptr;
+	for (int32 Side = 0; Side < 2; ++Side)
+	{
+		FGetUpFoot& Foot = GetUpRun.Feet[Side];
+		if (Animation && (Foot.bSwinging || Foot.bPlanted))
+		{
+			// Let go from the leg as it is now, held in the frame of the body as it is now (ReleaseFoot).
+			const FBodyInstance* Body = Mesh->GetBodyInstance(FootBoneName[Side]);
+			const FVector Point = Body && Body->IsValidBodyInstance() ? Body->GetUnrealWorldTransform().GetLocation() : Foot.Point;
+			const FTransform Frame = Mesh->GetComponentTransform();
+			Animation->SetLimbTarget(FootBoneIndex[Side], Point, 0.0, BlendS);
+			Animation->MoveLimbTarget(FootBoneIndex[Side], Point, &Frame);
+		}
+		Foot = FGetUpFoot();
+	}
+}
+
+void USandboxBodyController::UpdateRise(double DeltaTime, FAssist& Pelvis, const FBodyInstance& PelvisBody)
+{
+	USandboxAnimInstance* Animation = Cast<USandboxAnimInstance>(Mesh->GetAnimInstance());
+	const FSandboxGetUpTuning& Limits = Tuning.GetUp;
+	if (!Animation)
+	{
+		GiveUpGetUp(TEXT("the mesh has no animation instance"));
+		return;
+	}
+	const FTransform Now = PelvisBody.GetUnrealWorldTransform();
+	const FVector Forward = GetUpRun.Heading.RotateVector(FVector(0.0, 1.0, 0.0));
+	const FVector Left = GetUpRun.Heading.RotateVector(FVector(1.0, 0.0, 0.0));
+	const double FloorZ = LastSupportHeightCm;
+	const double UpCm = Now.GetLocation().Z - FloorZ;
+	const FVector UpNow = (Now.GetRotation() * (GetUpRun.Heading * Pelvis.SupportRotation).Inverse()).RotateVector(FVector::UpVector);
+	const double TiltDeg = FMath::RadiansToDegrees(FMath::Acos(FMath::Clamp(UpNow.Z, -1.0, 1.0)));
+	// A body held down does not go on.
+	const double PressedN = SustainedN.Size();
+	const bool bHeldDown = Limits.HoldForceN > 0.0 && PressedN >= Limits.HoldForceN;
+	GetUpView.PressedMaxN = FMath::Max(GetUpView.PressedMaxN, PressedN);
+	GetUpRun.StageS += DeltaTime;
+	const auto FootAt = [this](int32 Side) { const FBodyInstance* Foot = Mesh->GetBodyInstance(FootBoneName[Side]); return Foot ? Foot->GetUnrealWorldTransform().GetLocation() : FVector::ZeroVector; };
+	const auto KneeAt = [this](int32 Side) { const FBodyInstance* Knee = Mesh->GetBodyInstance(CalfBoneName[Side]); return Knee ? Knee->GetUnrealWorldTransform().GetLocation() : FVector::ZeroVector; };
+	const int32 Front = GetUpRun.Front;
+	const int32 Rear = 1 - Front;
+	const double FrontSign = Front == 0 ? 1.0 : -1.0;
+
+	FVector GoalAt = GetUpRun.PelvisGoal.GetLocation();
+	double LeanDeg = Limits.KneelLeanDeg;
+	const double StandCm = Pelvis.SupportLocation.Z + FootStandHeightCm[0];
+	switch (GetUpRun.Stage)
+	{
+	case EGetUpStage::Kneel:
+	{
+		const FVector Knees = 0.5 * (KneeAt(0) + KneeAt(1));
+		GoalAt = FVector(Knees.X, Knees.Y, FloorZ + Limits.KneelCm);
+		if (TiltDeg <= Limits.KneelLeanDeg + 20.0 && FMath::Abs(UpCm - Limits.KneelCm) <= 8.0 && Balance.Velocity.Size() <= 30.0 && !bHeldDown)
+		{
+			EnterGetUpStage(EGetUpStage::Foot);
+		}
+		break;
+	}
+	case EGetUpStage::Foot:
+	{
+		// The weight over the rear knee, so that the front leg is free.
+		const FVector Knee = KneeAt(Rear);
+		GoalAt = FVector(Knee.X + Left.X * FrontSign * 3.0, Knee.Y + Left.Y * FrontSign * 3.0, FloorZ + Limits.KneelCm);
+		LeanDeg = 0.0;
+		break;
+	}
+	case EGetUpStage::Rise:
+	{
+		const double Share = FMath::SmoothStep(0.0, 1.0, GetUpRun.RiseShare);
+		// Where the centre of mass is wanted: over the front foot's middle first, over both feet at the end.
+		const FVector FrontFoot = FootAt(Front) + Forward * 5.0;
+		const FVector BothFeet = 0.5 * (FootAt(0) + FootAt(1)) + Forward * 5.0;
+		const FVector Wanted = GetUpRun.Feet[Rear].bFlat ? FMath::Lerp(FrontFoot, BothFeet, Share) : FrontFoot;
+		FVector2D Off(Wanted.X - Balance.CenterOfMass.X, Wanted.Y - Balance.CenterOfMass.Y);
+		const double OutsideCm = Balance.IsSupported() ? -Balance.CenterOfMassMarginCm : 100.0;
+		Off = Off.GetClampedToMaxSize(Limits.RiseShiftCm);
+		const FVector At = Now.GetLocation();
+		GoalAt = FVector(At.X + Off.X, At.Y + Off.Y, FloorZ + FMath::Lerp(Limits.KneelCm, StandCm, Share));
+		LeanDeg = FMath::Max(Limits.RiseLeanDeg * (1.0 - Share), 0.0);
+		// The rise goes on while the body is over its feet and keeps up with it.
+		const bool bKeepsUp = GoalAt.Z - At.Z <= Limits.LagCm;
+		if (!bHeldDown && OutsideCm <= Limits.RiseOutsideCm && bKeepsUp)
+		{
+			GetUpRun.RiseShare = FMath::Min(GetUpRun.RiseShare + DeltaTime / FMath::Max(Limits.RiseS, 0.1), 1.0);
+			GetUpRun.StageS = FMath::Max(GetUpRun.StageS - DeltaTime, 0.0);
+		}
+		break;
+	}
+	default:
+		break;
+	}
+	// The goal glides: no stage begins with a jump.
+	const double Follow = 1.0 - FMath::Exp(-DeltaTime / 0.12);
+	const FQuat LeanTurn(-Left, FMath::DegreesToRadians(LeanDeg));
+	const FQuat GoalTurn = (LeanTurn * GetUpRun.Heading * Pelvis.SupportRotation).GetNormalized();
+	GetUpRun.PelvisGoal.SetLocation(FMath::Lerp(GetUpRun.PelvisGoal.GetLocation(), GoalAt, Follow));
+	GetUpRun.PelvisGoal.SetRotation(FQuat::Slerp(GetUpRun.PelvisGoal.GetRotation(), GoalTurn, Follow).GetNormalized());
+	Pelvis.Target = GetUpRun.PelvisGoal;
+	SetAssistTarget(Pelvis);
+	for (FAssist& Assist : Assists)
+	{
+		if (Assist.Slot == EAssistSlot::Feet)
+		{
+			Assist.Target = FlatFootTransform(Assist);
+			SetAssistTarget(Assist);
+		}
+	}
+	// The legs: solved from where the pelvis is wanted, so that they push it there.
+	FTransform PelvisNow = Now;
+	PelvisNow.SetScale3D(FVector::OneVector);
+	FTransform GoalFrame = Mesh->GetComponentTransform().GetRelativeTransform(PelvisNow) * GetUpRun.PelvisGoal;
+	GoalFrame.SetScale3D(FVector::OneVector);
+	FTransform UprightPelvis = GetUpRun.PelvisGoal;
+	UprightPelvis.SetRotation((GetUpRun.Heading * Pelvis.SupportRotation).GetNormalized());
+	const FQuat Level = (Mesh->GetComponentTransform().GetRelativeTransform(PelvisNow) * UprightPelvis).GetRotation();
+	if (GetUpRun.Stage == EGetUpStage::Foot || GetUpRun.Stage == EGetUpStage::Rise)
+	{
+		const double FootZ = FloorZ + FootStandHeightCm[Front];
+		if (GetUpRun.Stage == EGetUpStage::Foot)
+		{
+			const FVector From(KneeAt(Front).X, KneeAt(Front).Y, 0.0);
+			FVector Land = From + Forward * (Limits.FootAheadCm) ;
+			Land = FVector(Now.GetLocation().X, Now.GetLocation().Y, 0.0) + Forward * Limits.FootAheadCm + Left * (FrontSign * Limits.FootSideCm);
+			Land.Z = FootZ;
+			if (!GetUpRun.Feet[Front].bPlanted)
+			{
+				SwingGetUpFoot(Front, Land, DeltaTime, Level);
+			}
+			if (GetUpRun.Feet[Front].bPlanted)
+			{
+				// The rear foot is on its toes where it is, and is pushed from.
+				if (!GetUpRun.Feet[Rear].bPlanted)
+				{
+					FGetUpFoot& Foot = GetUpRun.Feet[Rear];
+					Foot.bPlanted = true;
+					Foot.Point = FootAt(Rear);
+					Animation->SetLimbTarget(FootBoneIndex[Rear], Foot.Point, 1.0, 0.2);
+				}
+				EnterGetUpStage(EGetUpStage::Rise);
+			}
+		}
+		if (GetUpRun.Stage == EGetUpStage::Rise)
+		{
+			FGetUpFoot& RearFoot = GetUpRun.Feet[Rear];
+			if (!RearFoot.bFlat && (GetUpRun.bRearForward || GetUpRun.RiseShare >= Limits.RearFrom) && Balance.FootForceN[Front] >= 0.4 * WeightN)
+			{
+				GetUpRun.bRearForward = true;
+			}
+			if (GetUpRun.bRearForward && !RearFoot.bFlat)
+			{
+				const FVector Land = FVector(FootAt(Front).X, FootAt(Front).Y, FloorZ + FootStandHeightCm[Rear]) - Left * (FrontSign * StanceRightFromLeft.Size());
+				SwingGetUpFoot(Rear, Land, DeltaTime, Level);
+			}
+		}
+		for (int32 Side = 0; Side < 2; ++Side)
+		{
+			FGetUpFoot& Foot = GetUpRun.Feet[Side];
+			if (Foot.bPlanted && !Foot.bSwinging)
+			{
+				const FVector At = FootAt(Side);
+				const double Z = Foot.bFlat ? FloorZ + FootStandHeightCm[Side] : At.Z;
+				Foot.Point = FMath::Lerp(Foot.Point, FVector(At.X, At.Y, Z), FMath::Min(DeltaTime / 0.1, 1.0));
+				Animation->MoveLimbTarget(FootBoneIndex[Side], Foot.Point, &GoalFrame, Foot.bFlat ? &Level : nullptr, Foot.bFlat ? 0.0 : 1.0, Tuning.Balance.LegExtensionMax);
+			}
+		}
+	}
+	bool bScaleMoves = false;
+	for (FGetUpFoot& Foot : GetUpRun.Feet)
+	{
+		const double Wanted = Foot.bSwinging ? FMath::Max(Limits.FootStiffnessScale, 1.0) : 1.0;
+		if (Foot.Scale != Wanted)
+		{
+			Foot.Scale = FMath::FInterpConstantTo(Foot.Scale, Wanted, DeltaTime, 10.0 * FMath::Max(FMath::Max(Limits.FootStiffnessScale, 1.0) - 1.0, 0.1));
+			bScaleMoves = true;
+		}
+	}
+	if (bScaleMoves)
+	{
+		PushTuningToControls();
+	}
+	if (FMath::FloorToInt32(ElapsedS * 4.0) != FMath::FloorToInt32((ElapsedS - DeltaTime) * 4.0))
+	{
+		UE_LOG(LogSandbox, Display, TEXT("Body controller: getting up at %.2f s: %s, share %.2f, pelvis %.0f cm up (goal %.0f), tilt %.0f deg, centre of mass %.0f cm inside the feet, floor on feet %.0f and %.0f N, assist %.2f"),
+			ElapsedS, GetUpStageName(GetUpRun.Stage), GetUpRun.RiseShare, UpCm, GetUpRun.PelvisGoal.GetLocation().Z - FloorZ, TiltDeg, Balance.IsSupported() ? Balance.CenterOfMassMarginCm : -99.0,
+			Balance.bValid ? Balance.FootForceN[0] : 0.0, Balance.bValid ? Balance.FootForceN[1] : 0.0, AssistLoad.ForceShare);
+	}
+	if (GetUpRun.StageS > Limits.StageMaxS)
+	{
+		GiveUpGetUp(FString::Printf(TEXT("stage %s took %.1f s (share %.2f, pelvis %.0f cm up, tilt %.0f deg)"), GetUpStageName(GetUpRun.Stage), GetUpRun.StageS, GetUpRun.RiseShare, UpCm, TiltDeg));
+		return;
+	}
+	if (GetUpRun.Stage == EGetUpStage::Rise && GetUpRun.RiseShare >= 1.0 && GetUpRun.Feet[Rear].bFlat && TiltDeg <= Limits.UprightDeg &&
+		Balance.bValid && Balance.FootForceN[0] > 0.0 && Balance.FootForceN[1] > 0.0 && UpCm >= StandCm - 8.0)
+	{
+		++GetUpView.Successes;
+		GetUpView.DurationS = ElapsedS - GetUpView.StartedS;
+		GivenUpClip.Reset();
+		EnterState(ESandboxBodyState::Standing, FString::Printf(TEXT("got up in %.2f s"), GetUpView.DurationS));
+	}
+}
